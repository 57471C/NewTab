{
	"name": "new-tab",
	"private": true,
	"version": "1.0.10",
	"type": "module",
	"scripts": {
		"icons": "node public/generate-icons.js",
		"dev": "vite",
		"prebuild": "node public/generate-icons.js",
		"build": "tsc -b && vite build",
		"preview": "vite preview",
		"lint": "biome lint ./src",
		"format": "biome format --write ./src",
		"test": "tsx --test src/**/*.test.ts"
	},
	"dependencies": {
		"dexie": "^4.4.4",
		"dexie-react-hooks": "^4.4.0",
		"lucide-react": "^1.17.0",
		"react": "^19.2.6",
		"react-dom": "^19.2.6",
		"tailwindcss": "^4.3.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@tailwindcss/vite": "^4.3.0",
		"@types/chrome": "^0.1.43",
		"@types/node": "^24.12.3",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"tsx": "^4.23.12",
		"typescript": "~6.0.2",
		"vite": "^8.0.12"
	},
	"description": "Minimalist local-first Chromium new-tab launcher and streaming AI companion.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/57471C/NewTab.git"
